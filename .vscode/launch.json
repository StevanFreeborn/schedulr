{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "arguments",
      "description": "The arguments to pass to the application",
      "type": "promptString",
      "default": ""
    }
  ],
  "configurations": [
    {
      "name": ".NET Core Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Schedulr.Console/bin/Debug/net9.0/Schedulr.Console.dll",
      "args": ["${input:arguments}"],
      "cwd": "${workspaceFolder}/src/Schedulr.Console",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
